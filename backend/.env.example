# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biodata_generator
DB_CONNECTION_LIMIT=10

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (for verification / password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Biodata Generator <no-reply@biodatagenerator.app>"

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# When STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_ASSET_BASE_URL=http://localhost:4000/uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Public site URL (used for QR codes / public biodata links)
PUBLIC_SITE_URL=http://localhost:5173
